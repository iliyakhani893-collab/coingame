<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Coin Clicker</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #111;
  color: white;
  font-family: Arial, sans-serif;
}

.game {
  text-align: center;
}

h1 {
  font-size: 28px;
  margin-bottom: 10px;
}

#coins {
  font-size: 34px;
  font-weight: bold;
  margin-bottom: 30px;
}

#coinButton {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  border: 5px solid #d99b00;
  background: #ffc928;
  font-size: 80px;
  cursor: pointer;
  transition: transform 0.1s;
}

#coinButton:active {
  transform: scale(0.92);
}

#reset {
  display: block;
  margin: 25px auto;
  padding: 10px 25px;
  background: #222;
  color: white;
  border: 1px solid #555;
  border-radius: 8px;
  cursor: pointer;
}
</style>
</head>

<body>

<div class="game">

  <h1>Coin Clicker 🪙</h1>

  <div id="coins">0 سکه</div>

  <button id="coinButton">🪙</button>

  <button id="reset">ریست</button>

</div>

<script>
let coins = 0;

const coinsText = document.getElementById("coins");
const coinButton = document.getElementById("coinButton");
const resetButton = document.getElementById("reset");

coinButton.addEventListener("click", function () {
  coins++;
  coinsText.textContent = coins + " سکه";
});

resetButton.addEventListener("click", function () {
  coins = 0;
  coinsText.textContent = "0 سکه";
});
</script>

</body>
</html>
